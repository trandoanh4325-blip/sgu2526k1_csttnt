git add
git commit -m "Tên ghi chú của bạn"
git push

# Di chuyển lesson1 và lesson2 vào Tuan01
mv python/lesson1 Tuan01/
mv python/lesson2 Tuan01/

# Xóa thư mục python hiện đã trống
rm -rf python

# Sao chép cả thư mục lesson1 và lesson2 vào Tuan01
cp -r python/lesson1 Tuan01/
cp -r python/lesson2 Tuan01/

# Xóa thư mục python (bao gồm cả các thư mục con bên trong nó)
rm -rf python